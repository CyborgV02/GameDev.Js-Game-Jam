.root {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgb(30, 30, 30);
    font-size: 14px;
}

.battle-viewport {
    flex: 1;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0);
}

.game-area {
    flex: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 0 40px 10px 40px;
    background-color: rgba(100, 100, 100, 0.15);
}

.game-area-2 {
    border-width: 2px;
    border-color: rgb(60, 60, 60);
}

.ally-container {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 0;
}

.ally-sprite {
    width: 64px;
    height: 80px;
    background-color: rgba(0, 0, 0, 0);
    margin-right: 8px;
}

.battle-menu {
    background-color: rgb(10, 10, 10);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(50, 50, 50);
    padding: 8px 10px;
    min-width: 280px;
    flex-direction: column;
}

.menu-top-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.ally-name {
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    margin-right: 10px;
    -unity-text-align: middle-left;
    width: 70px;
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/BlockCraft.otf?fileID=12800000&guid=c7fb38e5cdbfbcc45b99a5adc27fd083&type=3#BlockCraft");
    -unity-font-definition: initial;
}

.hp-bar-container {
    flex: 1;
    height: 14px;
    background-color: rgb(40, 0, 0);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    overflow: hidden;
}

.hp-bar-fill {
    width: 75%;
    height: 100%;
    background-color: rgb(255, 220, 0);
    border-radius: 2px;
    transition-property: width;
    transition-duration: 0.3s;
}

.action-buttons {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.action-btn {
    flex: 1;
    margin: 0 3px;
    padding: 6px 4px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(160, 160, 160);
    background-color: rgb(60, 60, 60);
    color: rgb(220, 220, 220);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    cursor: link;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.1s;
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/BlockCraft.otf?fileID=12800000&guid=c7fb38e5cdbfbcc45b99a5adc27fd083&type=3#BlockCraft");
    -unity-font-definition: initial;
}

.action-btn--selected {
    background-color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 100);
    color: rgb(0, 0, 0);
    scale: 1.05 1.05;
}

.text-bar {
    height: 120px;
    background-color: rgb(0, 0, 0);
    border-top-width: 3px;
    border-color: rgb(50, 50, 50);
    flex-direction: column;
    justify-content: center;
    padding: 0 20px;
}

.text-bar-inner {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    flex: 1;
    padding-top: 10px;
    padding-bottom: 10px;
}

.dialog-options {
    flex: 1;
    flex-direction: column;
    justify-content: center;
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/BlockCraft.otf?fileID=12800000&guid=c7fb38e5cdbfbcc45b99a5adc27fd083&type=3#BlockCraft");
    -unity-font-definition: initial;
    font-size: 18px;
    -unity-font-style: normal;
}

.dialog-option {
    color: rgb(150, 150, 150);
    font-size: 15px;
    padding: 3px 8px;
    margin: 2px 0;
    border-radius: 4px;
    -unity-text-align: middle-left;
    border-left-width: 3px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: color, border-color, background-color;
    transition-duration: 0.15s;
    cursor: link;
}

.dialog-option--selected {
    color: rgb(255, 255, 255);
    border-left-width: 3px;
    border-color: rgb(255, 255, 100);
    background-color: rgba(255, 255, 255, 0.08);
}

.nav-hint {
    justify-content: flex-end;
    align-items: flex-end;
    padding-bottom: 4px;
}

.nav-text {
    color: rgb(80, 80, 80);
    font-size: 11px;
    -unity-text-align: lower-right;
}
