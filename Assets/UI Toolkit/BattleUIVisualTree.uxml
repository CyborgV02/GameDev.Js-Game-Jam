<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/AllyStyle.uss?fileID=7433441132597879392&amp;guid=22c142a7e951e054fae46ca65e075477&amp;type=3#AllyStyle" />
    <ui:VisualElement name="MainContainer" style="height: 100%;">
        <ui:VisualElement name="InteractionContainer" style="height: 15%; transform-origin: bottom; top: 100%; translate: 0 -100%; background-color: rgb(0, 0, 0); justify-content: center; flex-direction: row;">
            <ui:VisualElement name="AllyContainer" class="ally" style="flex-grow: 0; width: 46%; margin-left: 0; flex-direction: row; background-color: rgba(8, 8, 8, 0);">
                <ui:VisualElement name="AllySprite" style="flex-grow: 0; width: 80px; height: 100%; top: -13px; background-image: url(&quot;project://database/Assets/PlaceHolders/Idle.png?fileID=-100665202&amp;guid=86efec807f2697e4a85c41bda477596e&amp;type=3#Idle_0&quot;);" />
                <ui:VisualElement name="DataContainer" class="ally" style="background-color: rgb(0, 0, 0); flex-direction: row; flex-wrap: nowrap; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 72%; height: 100%; translate: 0 0%; justify-content: center;">
                    <ui:VisualElement name="DataContainer" class="ally" style="flex-direction: column; flex-wrap: nowrap; width: 100%; height: 100%; background-color: rgba(8, 8, 8, 0); translate: 0 0%; margin-left: 0; justify-content: center; align-self: center; align-items: center; margin-right: 0;">
                        <ui:VisualElement name="DataContainer" style="flex-grow: 0; flex-direction: row; height: 100%; width: 100%;">
                            <ui:Label tabindex="-1" text="ALLY" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Name" style="height: 21px; width: 61px; -unity-text-align: upper-center; color: rgb(255, 255, 255); -unity-font-style: bold; top: 4px;" />
                            <ui:ProgressBar value="100" name="Health" style="width: 180px; height: 4px; top: 9px; scale: 1 0.5; -unity-background-scale-mode: stretch-to-fill;" />
                        </ui:VisualElement>
                        <ui:VisualElement name="ButtonsContainer" style="width: 100%; height: 25px; scale: 1 1; flex-direction: row; top: 0%; justify-content: center; transform-origin: center; translate: 0 0; right: 0%; flex-grow: 0;">
                            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="ATK" class="allyButton" />
                            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="HACK" class="allyButton" />
                            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="ITEM" class="allyButton" />
                            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="DESTROY" class="allyButton" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
