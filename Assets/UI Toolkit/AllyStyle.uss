.ally {
    height: 85%;
    width: 33%;
    transform-origin: bottom;
    translate: 0 -85%;
    background-color: rgb(8, 8, 8);
    border-top-right-radius: 20px;
    border-top-left-radius: 20px;
    margin-right: 10px;
    margin-left: 100px;
}

.allyButton {
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    height: 30px;
    width: 45px;
    top: -12px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/BlockCraft.otf?fileID=12800000&guid=c7fb38e5cdbfbcc45b99a5adc27fd083&type=3#BlockCraft");
    -unity-font-definition: initial;
    font-size: 22px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: clip;
}

